# ScopePay AI - Environment Variables

# Backend Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL & Authentication (Optional for local dev, schema in server/src/db/schema.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Google Gemini API (For AI Scope Generation & Scope Creep Comparison)
GEMINI_API_KEY=

# PayPal Sandbox Integration (REST API v2)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
